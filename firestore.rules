rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /books/{bookId} {
      // Helper function: authenticated
      function isAuthenticated() {
        return request.auth != null;
      }

      // Helper function: book validation rules
      function isValidBook() {
        let data = request.resource.data;
        return data.userId == request.auth.uid
          && data.title is string
          && data.title.trim().size() > 0
          && data.title.size() <= 100
          && data.author is string
          && data.author.trim().size() > 0
          && data.author.size() <= 60
          && data.genre in ['Fiction', 'Non-Fiction', 'Academic', 'Other']
          && data.status in ['To Read', 'Reading', 'Finished']
          && (!('rating' in data) || data.rating == null || ((data.rating is int || data.rating is number) && data.rating >= 0 && data.rating <= 5))
          && (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 300))
          && (!('favorite' in data) || data.favorite is bool);
      }

      // Read only own books
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Create new book: must be authenticated, owner, and valid schema
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid 
                    && isValidBook();

      // Update book: must be owner and keep valid schema
      allow update: if isAuthenticated() 
                    && resource.data.userId == request.auth.uid 
                    && request.resource.data.userId == request.auth.uid 
                    && isValidBook();

      // Delete book: must be owner
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
